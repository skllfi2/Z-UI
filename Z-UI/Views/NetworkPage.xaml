<!-- NetworkPage.xaml - Unified networking page: DNS + Proxifier + Telegram Proxy -->
<local:BasePage
x:Class="ZUI.Views.NetworkPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="using:ZUI.Views"
 xmlns:controls="using:ZUI.Controls">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Page Header (back button + title) — sticky on scroll -->
    <controls:PageHeader x:Name="HeaderControl" Grid.Row="0" Title="Сеть" Subtitle="Настройки DNS, прокси и маршрутизации трафика"/>

 <!-- TabView with 2 tabs: DNS, Telegram Proxy -->
  <TabView Grid.Row="1"
    IsAddTabButtonVisible="False"
    Padding="24,12,24,0">

    <!-- ═══ Tab 1: DNS ═══ -->
    <TabViewItem Header="DNS">
      <TabViewItem.IconSource>
        <FontIconSource Glyph="&#xE774;"/>
      </TabViewItem.IconSource>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="8,0,8,32" DataContext="{x:Bind DnsViewModel}">

          <!-- DNS Mode Selection -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Uid="Network_DnsModeLabel" Text="Выберите режим DNS" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                      DNS over HTTPS — шифрование DNS запросов через Windows. DNS Proxy — split routing: заблокированные через dns.malw.link, остальные через Cloudflare.
                    </TextBlock>
                  </StackPanel>
                  <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                    ItemsSource="{Binding DnsModes, Mode=OneWay}"
                    SelectedIndex="{Binding SelectedDnsMode, Mode=TwoWay}"
                    PlaceholderText="Выберите режим" x:Uid="Network_DnsModePlaceholder"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- DNS Proxy Section -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{Binding SelectedDnsMode, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1, Mode=OneWay}">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Uid="Network_DnsProxyTitle" Text="DNS Proxy (Встроенный)" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <!-- Status -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12"
                  Fill="{Binding IsDnsProxyRunning, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"/>
                <TextBlock Text="{Binding DnsProxyStatus, Mode=OneWay}"
                  FontSize="14" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- DNS Port -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Uid="Network_DnsProxyPort" Text="Порт DNS Proxy" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                  Value="{Binding DnsPort, Mode=TwoWay}"
                  Minimum="1024" Maximum="65535"
                  SpinButtonPlacementMode="Inline"/>
              </Grid>

              <!-- How it works -->
              <Border CornerRadius="8" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Spacing="8">
              <TextBlock x:Uid="Network_HowItWorks" Text="Как это работает:" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock x:Uid="Network_DnsProxyPoint1" Text="• DNS Proxy запускается на порту 5353" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Uid="Network_DnsProxyPoint2" Text="• Заблокированные сайты → dns.malw.link (обход блокировок)" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Uid="Network_DnsProxyPoint3" Text="• Остальные сайты → Cloudflare 1.1.1.1 (быстро и приватно)" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <TextBlock x:Uid="Network_DnsProxyPoint4" Text="• Не требует сторонних программ" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
              </Border>

              <!-- Actions -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                  Content="Запустить DNS Proxy"
                  Style="{ThemeResource AccentButtonStyle}"
                  Command="{Binding StartDnsProxyCommand}"
                  IsEnabled="{Binding IsDnsProxyApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Height="44"/>

                <Button Grid.Column="1"
                  Content="Остановить"
                  Command="{Binding StopDnsProxyCommand}"
                  IsEnabled="{Binding IsDnsProxyApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Height="44"/>
              </Grid>

              <ProgressBar IsIndeterminate="True"
                Visibility="{Binding IsDnsProxyApplying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
            </Grid>
          </Border>

          <!-- DNS over HTTPS Section (Windows 10/11) -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{Binding SelectedDnsMode, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0, Mode=OneWay}">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Uid="Network_DohTitle" Text="DNS over HTTPS (Windows)" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <!-- Current Status -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12" Fill="{Binding IsSecureDnsEnabled, Converter={StaticResource BoolToColorConverter}, Mode=OneWay}"/>
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="14"/>
              </StackPanel>

              <StackPanel Spacing="4" Visibility="{Binding ProviderName, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
                <TextBlock x:Uid="Network_DnsProvider" Text="Провайдер:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding ProviderName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>

              <!-- DoH Support Check -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource SuccessBrush}"
                  Visibility="{Binding IsDohSupported, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource ErrorBrush}"
                  Visibility="{Binding IsDohSupported, Converter={StaticResource BoolToVisibilityNegationConverter}, Mode=OneWay}"/>
                <TextBlock x:Uid="Network_DohInfo" Text="DNS over HTTPS (DoH) доступен на Windows 10 1903+ и Windows 11" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Provider Selection -->
              <Grid ColumnSpacing="16" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                  <TextBlock x:Uid="Network_SelectProvider" Text="Выбор провайдера DNS" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    🇷🇺 dns.malw.link — обход IP-блокировок · Google 8.8.8.8 — быстрый · Cloudflare 1.1.1.1 — приватность · Quad9 9.9.9.9 — безопасность
                  </TextBlock>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                  ItemsSource="{Binding Providers, Mode=OneWay}"
                  SelectedIndex="{Binding SelectedProviderIndex, Mode=TwoWay}"
                  PlaceholderText="Выберите провайдер" x:Uid="Network_SelectProviderPlaceholder"/>
              </Grid>

              <!-- Actions -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                  Content="Включить Secure DNS"
                  Style="{ThemeResource AccentButtonStyle}"
                  Command="{Binding EnableDohCommand}"
                  IsEnabled="{Binding IsApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Height="44"/>

                <Button Grid.Column="1"
                  Content="Отключить Secure DNS"
                  Command="{Binding DisableDohCommand}"
                  IsEnabled="{Binding IsApplying, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Height="44"/>
              </Grid>

              <ProgressBar IsIndeterminate="True"
                Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
            </Grid>
          </Border>

          <!-- DNS Refresh Button -->
          <Button Content="Обновить статус DNS"
            Command="{Binding RefreshCommand}"
            HorizontalAlignment="Left"/>

        </StackPanel>
      </ScrollViewer>
    </TabViewItem>

    <!-- ═══ Tab 2: Telegram Proxy ═══ -->
    <TabViewItem Header="Telegram Proxy">
      <TabViewItem.IconSource>
        <FontIconSource Glyph="&#xE708;"/>
      </TabViewItem.IconSource>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="8,0,8,32" DataContext="{x:Bind TgProxyViewModel}">

          <!-- SOCKS5→WebSocket Proxy Card -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE708;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Uid="Network_Socks5Title" Text="SOCKS5 → WebSocket" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <!-- Status -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12"
                  Fill="{StaticResource SuccessBrush}"
                  Visibility="{Binding IsSocks5Running, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                <Ellipse Width="12" Height="12"
                  Fill="{StaticResource ErrorBrush}"
                  Visibility="{Binding IsSocks5Running, Converter={StaticResource BoolToVisibilityNegationConverter}, Mode=OneWay}"/>
                <TextBlock Text="{Binding Socks5Status, Mode=OneWay}" FontSize="14" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Port -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Порт SOCKS5" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                  Value="{Binding Socks5Port, Mode=TwoWay}"
                  Minimum="1024" Maximum="65535"
                  SpinButtonPlacementMode="Inline"/>
              </Grid>

              <!-- WebSocket URL -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="WebSocket URL" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                  Text="{Binding WsUrl, Mode=TwoWay}"
                  PlaceholderText="wss://web.telegram.org/ws"/>
              </Grid>

              <!-- Secret -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Секрет (опционально)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                  Password="{Binding WsSecret, Mode=TwoWay}"
                  PlaceholderText="Секрет для WebSocket"/>
              </Grid>

              <!-- Toggle -->
              <Button Content="{Binding IsSocks5Running, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Остановить|Запустить', Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{Binding ToggleSocks5Command}"
                IsEnabled="{Binding IsSocks5Toggling, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                Height="44"/>

              <ProgressBar IsIndeterminate="True"
                Visibility="{Binding IsSocks5Toggling, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
            </Grid>
          </Border>

          <!-- MTProxy Card -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8BD;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Uid="Network_MtProxyTitle" Text="MTProxy" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <!-- Status -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12"
                  Fill="{StaticResource SuccessBrush}"
                  Visibility="{Binding IsMtProxyRunning, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                <Ellipse Width="12" Height="12"
                  Fill="{StaticResource ErrorBrush}"
                  Visibility="{Binding IsMtProxyRunning, Converter={StaticResource BoolToVisibilityNegationConverter}, Mode=OneWay}"/>
                <TextBlock Text="{Binding MtProxyStatus, Mode=OneWay}" FontSize="14" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Port -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Порт MTProxy" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                  Value="{Binding MtProxyPort, Mode=TwoWay}"
                  Minimum="1024" Maximum="65535"
                  SpinButtonPlacementMode="Inline"/>
              </Grid>

              <!-- Secret -->
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Секрет MTProxy" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                  Password="{Binding MtProxySecret, Mode=TwoWay}"
                  PlaceholderText="dd_SECRET"/>
              </Grid>

              <!-- Toggle -->
              <Button Content="{Binding IsMtProxyRunning, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Остановить|Запустить', Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{Binding ToggleMtProxyCommand}"
                IsEnabled="{Binding IsMtProxyToggling, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                Height="44"/>

              <ProgressBar IsIndeterminate="True"
                Visibility="{Binding IsMtProxyToggling, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
            </Grid>
          </Border>

          <!-- Proxy Link Card -->
          <Border CornerRadius="12" Padding="24"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{Binding ProxyLink, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
            <Grid>
              <controls:SystemBackdropElement CornerRadius="12">
                <controls:SystemBackdropElement.SystemBackdrop>
                  <MicaBackdrop Kind="Base"/>
                </controls:SystemBackdropElement.SystemBackdrop>
              </controls:SystemBackdropElement>
              <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE71B;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Ссылка для подключения" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <Border CornerRadius="8" Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TextBlock Text="{Binding ProxyLink, Mode=OneWay}"
                  FontSize="14" IsTextSelectionEnabled="True"
                  TextWrapping="Wrap"/>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Копировать ссылку"
                  Command="{Binding CopyProxyLinkCommand}"/>
                <Button Content="QR-код" IsEnabled="False" ToolTipService.ToolTip="QR-код будет добавлен в будущей версии"/>
              </StackPanel>
            </StackPanel>
            </Grid>
          </Border>

          <!-- Actions -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Остановить все"
              Command="{Binding StopAllCommand}"/>
            <Button Content="Обновить статус"
              Command="{Binding RefreshStatusCommand}"/>
          </StackPanel>

          <!-- Active Connections -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
            <TextBlock FontSize="14">
              <Run Text="Активных соединений: "/><Run Text="{Binding ActiveConnections, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </TabViewItem>

  </TabView>
  </Grid>
</local:BasePage>
