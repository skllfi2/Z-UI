<!-- GeneratorPage.xaml - Strategy generator page (ready strategies + custom creation) -->
<views:BasePage
    x:Class="ZUI.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ZUI.Views"
    xmlns:controls="using:ZUI.Controls"
    xmlns:helpers="using:ZUI.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <controls:PageHeader x:Name="HeaderControl" Grid.Row="0"
            Title="Генератор стратегий"
            Subtitle="Выберите готовую стратегию или создайте свою"/>

        <!-- TabView with two tabs -->
        <TabView Grid.Row="1"
            SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
            IsAddTabButtonVisible="False"
            Padding="24,12,24,0">

            <!-- Tab 1: Ready Strategies -->
            <TabViewItem Header="Готовые стратегии">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="List"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20" Padding="8,0,8,32">

                        <!-- Current Strategy -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="Generator_CurrentStrategy" Text="Текущая стратегия" FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentStrategyName, Mode=OneWay}"
                                    FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Strategy Selection -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock x:Uid="Generator_SelectStrategy" Text="Выбор стратегии" FontSize="16" FontWeight="SemiBold"/>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Uid="Generator_StrategyLabel" Text="Стратегия" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock x:Uid="Generator_StrategyDesc" Text="Выберите готовую стратегию для обхода DPI" FontSize="12"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox MinWidth="250" VerticalAlignment="Center"
                  ItemsSource="{Binding AvailableStrategies, Mode=OneWay}"
                  SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  PlaceholderText="Выберите стратегию" x:Uid="Generator_SelectStrategyPlaceholder"/>
                <Button Command="{Binding RefreshStrategiesCommand}" Height="32" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
                        </Border>

                        <!-- Test -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="Generator_Testing" Text="Тестирование" FontSize="16" FontWeight="SemiBold"/>

                                <Button Height="40" FontSize="14" HorizontalAlignment="Stretch"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{Binding TestStrategyCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE117;" FontSize="16"/>
              <TextBlock x:Uid="Generator_Test" Text="Тестировать"/>
                                    </StackPanel>
                                </Button>

                                <ProgressBar IsIndeterminate="True"
                                    Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

                                <TextBlock Text="{Binding TestResult, Mode=OneWay}"
                                    FontSize="13" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{Binding TestResult, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Tab 2: Create Strategy -->
            <TabViewItem Header="Создание стратегии">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Edit"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20" Padding="8,0,8,32">

                        <!-- Step 1: Service Selection -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Uid="Generator_SelectServices" Text="Выберите сервисы" FontSize="18" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Uid="Generator_SelectServicesDesc" Text="Отметьте сервисы, которые должны работать:"
                                    FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <GridView x:Name="ServicesGridView"
                                    ItemsSource="{Binding AvailableServices, Mode=OneWay}"
                                    SelectionMode="Multiple"
                                    SelectionChanged="ServicesGridView_SelectionChanged">
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="140" Height="100" Margin="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                                    <TextBlock Text="{Binding Icon}" FontSize="32"
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                                        HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- Custom domains section -->
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <TextBlock x:Uid="Generator_OrAddDomains" Text="Или добавьте свои домены:" FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="CustomDomainTextBox"
                                            Grid.Column="0"
                                            PlaceholderText="example.com, another-site.org" x:Uid="Generator_DomainPlaceholder"
                                            Height="32"/>

                                        <Button Grid.Column="1" Height="32" Click="AddCustomDomain_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                                <TextBlock x:Uid="Generator_Add" Text="Добавить"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ItemsControl x:Name="CustomDomainsList"
                                        ItemsSource="{Binding CustomDomains, Mode=OneWay}"
                                        Visibility="{Binding HasCustomDomains, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid Orientation="Horizontal" HorizontalAlignment="Left"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4" Padding="8,4" Margin="4">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"/>
                                                        <Button Grid.Column="1"
                                                            FontSize="10" Padding="4,2"
                                                            Click="RemoveCustomDomain_Click"
                                                            Tag="{Binding}">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: DPI Method Selection -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Uid="Generator_BypassMethod" Text="Метод обхода" FontSize="18" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Uid="Generator_BypassMethodDesc" Text="Выберите метод DPI обхода и настройте параметры:"
                                    FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Method selection ComboBox -->
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="Generator_BypassMethodLabel" Text="Метод обхода" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedDpiMethod.Description, Mode=OneWay}"
                  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                  Visibility="{Binding SelectedDpiMethod, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox MinWidth="250" VerticalAlignment="Center"
                  ItemsSource="{Binding AvailableDpiMethods, Mode=OneWay}"
                  SelectedItem="{Binding SelectedDpiMethod, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  PlaceholderText="Выберите метод" x:Uid="Generator_SelectMethod"/>
                <!-- Stability indicator -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                  Visibility="{Binding SelectedDpiMethod, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                  <FontIcon Glyph="&#xE774;" FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                  <TextBlock Text="{Binding SelectedDpiMethod.Stability, Mode=OneWay}" FontSize="12"/>
                  <TextBlock Text="%" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Fooling Mode -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowFoolingSelector, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Uid="Generator_FoolingMode" Text="Режим fooling" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                SelectedItem="{Binding SelectedFooling, Mode=TwoWay}">
                <ComboBoxItem Content="badseq" Tag="badseq"/>
                <ComboBoxItem Content="md5sig" Tag="md5sig"/>
                <ComboBoxItem Content="ts" Tag="ts"/>
                <ComboBoxItem Content="md5sig,badseq" Tag="md5sig,badseq"/>
                <ComboBoxItem Content="ts,md5sig" Tag="ts,md5sig"/>
              </ComboBox>
            </Grid>

            <!-- Fake Repeats -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowFakeRepeats, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Uid="Generator_RepeatCount" Text="Количество повторов" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <NumberBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                Value="{Binding FakeRepeats, Mode=TwoWay}"
                Minimum="1" Maximum="20"
                SpinButtonPlacementMode="Compact"/>
            </Grid>

            <!-- Split Parameters -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowSplitParams, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Uid="Generator_SplitParams" Text="Параметры разбиения" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Grid Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock x:Uid="Generator_Seqovl" Text="Seqovl" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <NumberBox Value="{Binding SplitSeqovl, Mode=TwoWay}"
                    Minimum="0" Maximum="65535"
                    SpinButtonPlacementMode="Compact" MinWidth="100"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock x:Uid="Generator_SplitPos" Text="Split pos" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <ComboBox MinWidth="120"
                    SelectedItem="{Binding SplitPos, Mode=TwoWay}"
                    IsEditable="True">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="1,midsld"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- Fakedsplit Pattern -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowFakedsplitPattern, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Uid="Generator_FakedsplitPattern" Text="Паттерн fakedsplit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                Text="{Binding FakedsplitPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="0x00"/>
            </Grid>

            <!-- Hostfakesplit Mod -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowHostfakesplitMod, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Uid="Generator_HostfakesplitModifier" Text="Модификатор hostfakesplit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center"
                SelectedItem="{Binding HostfakesplitMod, Mode=TwoWay}"
                IsEditable="True">
                <ComboBoxItem Content="host=www.google.com"/>
                <ComboBoxItem Content="host=www.youtube.com"/>
                <ComboBoxItem Content="altorder=1"/>
              </ComboBox>
            </Grid>

            <!-- Combine Multidisorder toggle -->
            <Grid ColumnSpacing="16"
              Visibility="{Binding ShowCombineMultidisorder, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="Generator_CombineMultidisorder" Text="Комбинировать с multidisorder" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                  <Run Text="Выкл: "/><Run Text="Только syndata"/><Run Text=" · Вкл: "/><Run Text="syndata + multidisorder"/>
                </TextBlock>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                IsOn="{Binding CombineMultidisorder, Mode=TwoWay}"
                OffContent="" OnContent=""/>
            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: ISP Detection -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="3" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Uid="Generator_DetectProvider" Text="Определение провайдера" FontSize="18" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="{Binding DetectedProviderName, Mode=OneWay}"
                                            FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DetectedProviderInfo, Mode=OneWay}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"/>
                                        <ProgressBar IsIndeterminate="True"
                                            Visibility="{Binding IsDetectingProvider, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{Binding ChangeProviderCommand}"
                                        VerticalAlignment="Center" Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            <TextBlock x:Uid="Generator_Change" Text="Изменить"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Step 4: Test Mode -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="4" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Uid="Generator_TestMode" Text="Режим тестирования" FontSize="18" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="Generator_TestModeLabel" Text="Режим тестирования" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Uid="Generator_TestModeDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                  Быстрый: базовая проверка DNS и TCP · Полный: реальная проверка сервисов · Пропустить: без тестирования
                </TextBlock>
              </StackPanel>
              <ComboBox Grid.Column="1" MinWidth="250" VerticalAlignment="Center" Height="36"
                SelectedIndex="{Binding SelectedTestMode, Mode=TwoWay}">
                <ComboBoxItem x:Uid="Generator_QuickTest" Content="Быстрый (30 сек)">
                  <ComboBoxItem.Tag>Quick</ComboBoxItem.Tag>
                </ComboBoxItem>
                <ComboBoxItem x:Uid="Generator_FullTest" Content="Полный (5 мин)">
                  <ComboBoxItem.Tag>Full</ComboBoxItem.Tag>
                </ComboBoxItem>
                <ComboBoxItem x:Uid="Generator_NoTest" Content="Пропустить тестирование">
                  <ComboBoxItem.Tag>None</ComboBoxItem.Tag>
                </ComboBoxItem>
              </ComboBox>
            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Step 5: Results -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasTestResults, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="5" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Uid="Generator_ResultsTitle" Text="Результаты тестирования" FontSize="18" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding GeneratedStrategyName, Mode=OneWay}"
                                    FontSize="16" FontWeight="SemiBold"/>

                                <ListView ItemsSource="{Binding TestResults, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                                    Visibility="{Binding Passed, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                <FontIcon Grid.Column="0" Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource ErrorBrush}"
                                                    Visibility="{Binding Passed, Converter={StaticResource BoolToVisibilityNegationConverter}, Mode=OneWay}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding ServiceName}" FontSize="14"/>

                                                <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Winws Arguments Preview -->
                        <Border CornerRadius="12" Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{Binding GeneratedWinwsArgs, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE943;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Аргументы winws.exe" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Border CornerRadius="6" Padding="12" Margin="0,8,0,0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding GeneratedWinwsArgs, Mode=OneWay}"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="12" IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </Expander>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid ColumnSpacing="12" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Height="44" FontSize="14" HorizontalAlignment="Stretch"
                                Command="{Binding RunTestCommand}"
                                IsEnabled="{Binding CanRunTest, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE117;" FontSize="16"/>
                                    <TextBlock Text="Тестировать"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Height="44" FontSize="14" HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding ApplyStrategyCommand}"
                                IsEnabled="{Binding CanApply, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                    <TextBlock x:Uid="Generator_ApplyStrategy" Text="Применить"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <!-- Change Provider ContentDialog -->
        <ContentDialog x:Name="ChangeProviderDialog"
            Title="Выбор провайдера"
            PrimaryButtonText="Выбрать"
            CloseButtonText="Отмена"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="{Binding DialogSelectedProfile, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"
            Opened="ChangeProviderDialog_Opened"
            PrimaryButtonClick="ChangeProviderDialog_PrimaryButtonClick">
            <StackPanel Spacing="12" MinWidth="400">
                <TextBlock Text="Выберите вашего интернет-провайдера из списка:"
                    FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <ListView ItemsSource="{Binding AvailableProfiles, Mode=OneWay}"
                    SelectedItem="{Binding DialogSelectedProfile, Mode=TwoWay}"
                    SelectionMode="Single" MinHeight="200" MaxHeight="400">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Padding="4,8">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>

    </Grid>
</views:BasePage>
