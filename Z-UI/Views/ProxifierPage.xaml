<!-- ProxifierPage.xaml - Proxy routing configuration page -->
<views:BasePage
    x:Class="ZUI.Views.ProxifierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ZUI.Views"
    xmlns:controls="using:ZUI.Controls"
    xmlns:models="using:ZUI.Models">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Page Header -->
    <controls:PageHeader x:Name="HeaderControl" Grid.Row="0"
      x:Uid="Proxifier_Header" Title="Проксификатор" Subtitle="Настройка прокси-маршрутизации"/>

    <!-- TabView with 3 tabs -->
    <TabView Grid.Row="1"
      IsAddTabButtonVisible="False"
      Padding="24,12,24,0">

      <!-- Tab 1: Proxy Servers -->
      <TabViewItem x:Uid="Proxifier_TabServers" Width="110">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="8,0,8,32">

            <!-- Status Card -->
            <Border CornerRadius="12" Padding="24"
              Background="Transparent"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
              <Grid>
                <controls:SystemBackdropElement CornerRadius="12">
                  <controls:SystemBackdropElement.SystemBackdrop>
                    <MicaBackdrop Kind="Base"/>
                  </controls:SystemBackdropElement.SystemBackdrop>
                </controls:SystemBackdropElement>
                <StackPanel Spacing="8">
                  <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    x:Name="StatusSubtext"
                    Text="{x:Bind ViewModel.Servers.Count, Mode=OneWay, FallbackValue='0 servers'}"/>

                </StackPanel>
              </Grid>
            </Border>

            <!-- Add Server Button -->
            <Button HorizontalAlignment="Right" Padding="16,8"
              Click="ShowAddServerDialog_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                <TextBlock x:Uid="Proxifier_AddServer"/>
              </StackPanel>
            </Button>

            <!-- Server List -->
            <ListView
              ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
              SelectionMode="None"
              HorizontalContentAlignment="Stretch">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProxyServerDisplayModel">
                  <Grid Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind Host}"/><Run Text=":"/><Run Text="{x:Bind Port}"/>
                        <Run Text=" &#x2022; "/><Run Text="{x:Bind ProxyType}"/>
                      </TextBlock>
                      <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind AuthenticationEnabled, Mode=OneWay}"
                        x:Uid="Proxifier_AuthEnabled"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
                      <Button x:Uid="Proxifier_CheckButton"
                        Tag="{x:Bind Name}"
                        Click="CheckServerButton_Click">
                        <FontIcon Glyph="&#xE774;" FontSize="14"/>
                      </Button>
                      <Button x:Uid="Proxifier_RemoveServerButton"
                        Tag="{x:Bind Name}"
                        Click="RemoveServerButton_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>

      <!-- Tab 2: Rules -->
      <TabViewItem x:Uid="Proxifier_TabRules" Width="110">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="8,0,8,32">

            <!-- Add Rule Button -->
            <Button HorizontalAlignment="Right" Padding="16,8"
              Click="ShowAddRuleDialog_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                <TextBlock x:Uid="Proxifier_AddRule"/>
              </StackPanel>
            </Button>

            <!-- Rule List -->
            <ListView
              ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
              SelectionMode="None"
              HorizontalContentAlignment="Stretch">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProxyRuleDisplayModel">
                  <Grid Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"/>
                        <Border
                          Padding="4,2"
                          CornerRadius="4"
                          Background="{ThemeResource AccentFillColorDefaultBrush}"
                          Visibility="{x:Bind IsEnabled, Mode=OneWay}">
                          <TextBlock FontSize="10" x:Uid="Proxifier_Enabled"/>
                        </Border>
                      </StackPanel>
                      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind Action}"/><Run Text=" "/>
                        <Run Text="&#x2022;"/><Run Text=" "/>
                        <Run Text="{x:Bind DestinationDomain, FallbackValue='any'}"/><Run Text=" "/>
                        <Run Text="&#x2022;"/><Run Text=" "/>
                        <Run Text="{x:Bind ProcessName, FallbackValue='any app'}"/><Run Text=" "/>
                      </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
                      <Button x:Uid="Proxifier_RemoveRuleButton"
                        Tag="{x:Bind Id}"
                        Click="RemoveRuleButton_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>

      <!-- Tab 3: Chains -->
      <TabViewItem x:Uid="Proxifier_TabChains" Width="110">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xEA3C;" FontSize="32"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock x:Uid="Proxifier_ChainsComingSoon"
              FontSize="14"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
          </StackPanel>
        </Grid>
      </TabViewItem>

    </TabView>

    <!-- Server Dialog -->
  <ContentDialog x:Name="AddServerDialog"
    x:Uid="Proxifier_AddServerDialog"
      DefaultButton="Primary"
      PrimaryButtonClick="AddServerDialog_PrimaryButtonClick">
      <StackPanel Spacing="12" MinWidth="400">
    <TextBox x:Name="ServerNameTextBox" x:Uid="Proxifier_ServerNameTextBox"/>
    <TextBox x:Name="ServerHostTextBox" x:Uid="Proxifier_ServerHostTextBox"/>
        <NumberBox x:Name="ServerPortNumberBox" x:Uid="Proxifier_ServerPortNumberBox" Value="1080" SpinButtonPlacementMode="Inline"/>
        <ComboBox x:Name="ServerTypeComboBox" x:Uid="Proxifier_ServerTypeComboBox" SelectedIndex="2">
          <ComboBoxItem x:Uid="Proxifier_Socks4"/>
          <ComboBoxItem x:Uid="Proxifier_Socks4a"/>
          <ComboBoxItem x:Uid="Proxifier_Socks5"/>
          <ComboBoxItem x:Uid="Proxifier_HttpConnect"/>
        </ComboBox>
        <CheckBox x:Name="ServerAuthCheckBox" x:Uid="Proxifier_ServerAuthCheckBox"
          Checked="ServerAuthCheckBox_Checked" Unchecked="ServerAuthCheckBox_Unchecked"/>
        <StackPanel x:Name="ServerAuthPanel" Visibility="Collapsed">
          <TextBox x:Name="ServerUsernameTextBox" x:Uid="Proxifier_ServerUsernameTextBox" Margin="0,8,0,0"/>
          <PasswordBox x:Name="ServerPasswordBox" x:Uid="Proxifier_ServerPasswordBox" Margin="0,8,0,0"/>
        </StackPanel>
        <ComboBox x:Name="DnsPolicyComboBox" x:Uid="Proxifier_DnsPolicyComboBox" SelectedIndex="0">
          <ComboBoxItem x:Uid="Proxifier_Local"/>
          <ComboBoxItem x:Uid="Proxifier_ThroughProxy"/>
        </ComboBox>
      </StackPanel>
    </ContentDialog>

    <!-- Rule Dialog -->
  <ContentDialog x:Name="AddRuleDialog"
    x:Uid="Proxifier_AddRuleDialog"
      DefaultButton="Primary"
      PrimaryButtonClick="AddRuleDialog_PrimaryButtonClick">
      <StackPanel Spacing="12" MinWidth="400">
    <TextBox x:Name="RuleNameTextBox" x:Uid="Proxifier_RuleNameTextBox"/>
    <CheckBox x:Name="RuleEnabledCheckBox" x:Uid="Proxifier_RuleEnabledCheckBox" IsChecked="True"/>
    <NumberBox x:Name="RulePriorityNumberBox" x:Uid="Proxifier_RulePriorityNumberBox" Value="1" Minimum="1" SpinButtonPlacementMode="Inline"/>
    <TextBox x:Name="RuleProcessNameTextBox" x:Uid="Proxifier_RuleProcessNameTextBox"/>
    <TextBox x:Name="RuleDomainTextBox" x:Uid="Proxifier_RuleDomainTextBox"/>
        <ComboBox x:Name="RuleActionComboBox" x:Uid="Proxifier_RuleActionComboBox" SelectedIndex="0">
          <ComboBoxItem x:Uid="Proxifier_Direct"/>
          <ComboBoxItem x:Uid="Proxifier_Proxy"/>
          <ComboBoxItem x:Uid="Proxifier_Chain"/>
          <ComboBoxItem x:Uid="Proxifier_Block"/>
        </ComboBox>
        <ComboBox x:Name="RuleProxyServerComboBox" x:Uid="Proxifier_RuleProxyServerComboBox"
          ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
          DisplayMemberPath="Name"/>
        <ComboBox x:Name="RuleDnsPolicyComboBox" x:Uid="Proxifier_RuleDnsPolicyComboBox" SelectedIndex="0">
          <ComboBoxItem x:Uid="Proxifier_Local"/>
          <ComboBoxItem x:Uid="Proxifier_ThroughProxy"/>
        </ComboBox>
      </StackPanel>
    </ContentDialog>

  </Grid>
</views:BasePage>