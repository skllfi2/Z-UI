<!-- AboutPage.xaml - About page with version, license, and links -->
<views:BasePage
    x:Class="ZUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ZUI.Views"
    xmlns:controls="using:ZUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <controls:PageHeader x:Name="HeaderControl" Grid.Row="0"
            Title="{Binding Title}" Subtitle="{Binding Subtitle}"/>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Padding="32,0,32,32">

                <!-- App Info Card -->
                <Border CornerRadius="12" Padding="32"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" HorizontalAlignment="Center" MaxWidth="500">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <!-- App Icon -->
                        <Image Source="Assets/Z-UI-48x48.png" Width="64" Height="64" HorizontalAlignment="Center"/>

                        <TextBlock Text="Z-UI" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6"
                            Padding="12,6" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding AboutVersionLabel}" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding AppVersion, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Version Info -->
                <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding VersionsTitle}" FontSize="16" FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ZapretLabel}" FontSize="14"
                                VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ZapretVersion, Mode=OneWay}" FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding WorkerLabel}" FontSize="14"
                                VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding WorkerVersion, Mode=OneWay}" FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding LinksTitle}" FontSize="16" FontWeight="SemiBold"/>

                        <!-- GitHub -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GitHubLabel}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GitHubDesc}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding OpenLabel}"
                                Command="{Binding OpenGitHubCommand}" Padding="16,6"/>
                        </Grid>

                        <!-- Zapret -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A7;" FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ZapretProjectLabel}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ZapretProjectDesc}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding OpenLabel}"
                                Command="{Binding OpenZapretCommand}" Padding="16,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dependencies -->
                <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DependenciesTitle}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DependenciesInfo}" FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- License + Copyright -->
                <Border CornerRadius="12" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LicenseLabel}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LicenseInfo}" FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Copyright}" FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:BasePage>
