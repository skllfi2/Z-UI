<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType>
<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
<RootNamespace>ZUI</RootNamespace>
<UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
<EnableMsixTooling>false</EnableMsixTooling>
<Nullable>enable</Nullable>
<ImplicitUsings>enable</ImplicitUsings>
<LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <!-- Suppress auto-generated Main() — we provide a custom entry point in Program.cs -->
  <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64;x86;ARM64</Platforms>
<RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
<ApplicationIcon>Assets\Z-UI.ico</ApplicationIcon>
<!-- Workaround for XamlCompiler exit code 1 with .NET 10 -->
<XamlCompilerDisablePeerAssemblyGeneration>true</XamlCompilerDisablePeerAssemblyGeneration>
<!-- Suppress MVVMTK0045 warnings - private fields are stable for WinUI 3 -->
<!-- Suppress minor code quality warnings -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress MVVMTK0045 - private fields are stable for WinUI 3 -->
    <!-- Suppress style/structure warnings that don't affect correctness -->
    <NoWarn>$(NoWarn);MVVMTK0045;CA1051;CA1056;CA1819;CA2227;CA1063;CA1805;CA1822;CA1801;CA1054;CA1823</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
  </ItemGroup>

  <!-- Copy zapret folder to output -->
  <ItemGroup>
    <Content Include="zapret\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy Assets -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZUI.Core\ZUI.Core.csproj" />
    <ProjectReference Include="..\ZUI.Ipc\ZUI.Ipc.csproj" />
    <!-- ZUI.Worker: build dependency only (Native AOT exe, not a library).
         ReferenceOutputAssembly=false prevents referencing Worker DLLs.
         PublishTargetsOnly ensures Worker is published during dotnet publish. -->
    <ProjectReference Include="..\ZUI.Worker\ZUI.Worker.csproj" ReferenceOutputAssembly="false" PublishTargetsOnly="true" />
  </ItemGroup>

  <!-- After Worker builds, publish it as Native AOT and copy to Z-UI output under ZUI.Worker\ subfolder.
       This creates a standalone executable that doesn't require .NET runtime dependencies. -->
  <Target Name="PublishWorkerBinary" AfterTargets="Build" Condition="!Exists('$(TargetDir)ZUI.Worker\ZUI.Worker.exe')">
    <PropertyGroup>
      <WorkerProjectPath>$(MSBuildThisFileDirectory)..\ZUI.Worker\ZUI.Worker.csproj</WorkerProjectPath>
      <WorkerPublishPath>$(MSBuildThisFileDirectory)..\ZUI.Worker\bin\Debug\$(TargetFramework)\win-$(Platform)\publish\</WorkerPublishPath>
      <WorkerDestPath>$(TargetDir)ZUI.Worker\</WorkerDestPath>
    </PropertyGroup>
    <MakeDir Directories="$(WorkerDestPath)" />
    <!-- Publish Worker as Native AOT if not already published -->
    <Exec Command="dotnet publish &quot;$(WorkerProjectPath)&quot; -c $(Configuration) -r win-$(Platform) --no-restore" Condition="!Exists('$(WorkerPublishPath)ZUI.Worker.exe')" />
    <!-- Copy Native AOT executable and PDBs -->
    <Exec Command="xcopy &quot;$(WorkerPublishPath)*.exe&quot; &quot;$(WorkerDestPath)&quot; /Y" />
    <Exec Command="xcopy &quot;$(WorkerPublishPath)*.pdb&quot; &quot;$(WorkerDestPath)&quot; /Y" />
    <!-- Copy WinDivert dependencies from zapret folder -->
    <Exec Command="xcopy &quot;$(MSBuildThisFileDirectory)zapret\WinDivert.dll&quot; &quot;$(WorkerDestPath)&quot; /Y" />
    <Exec Command="xcopy &quot;$(MSBuildThisFileDirectory)zapret\WinDivert64.sys&quot; &quot;$(WorkerDestPath)&quot; /Y" />
  </Target>
</Project>
