<Application x:Class="ZUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="using:ZUI.Converters">
 <Application.Resources>
 <ResourceDictionary>
 <ResourceDictionary.MergedDictionaries>
 <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
 </ResourceDictionary.MergedDictionaries>

  <!-- Converters -->
  <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  <converters:InverseBoolToVisibilityConverter x:Key="BoolToVisibilityNegationConverter"/>
  <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
  <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
  <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
  <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
  <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
    <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

  <!-- Theme-aware Status Colors -->
  <Color x:Key="SuccessColor">#107C10</Color>
  <Color x:Key="WarningColor">#F7630C</Color>
  <Color x:Key="ErrorColor">#C50500</Color>
  <Color x:Key="InfoColor">#0078D4</Color>

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

 <!-- Easing Functions -->
 <CircleEase x:Key="CircleEase" EasingMode="EaseOut"/>
 <QuadraticEase x:Key="QuadraticEase" EasingMode="EaseOut"/>
 <ExponentialEase x:Key="ExponentialEase" EasingMode="EaseOut"/>
 <BackEase x:Key="BackEase" EasingMode="EaseOut" Amplitude="0.3"/>

 <!-- ========== THEME SHADOW FOR DEPTH ========== -->
 <!-- Shadow for cards - creates depth hierarchy -->
 <ThemeShadow x:Key="CardShadow"/>

 <!-- Shadow configuration -->
 <x:Double x:Key="CardShadowDepth">16</x:Double>

 <!-- ========== CARD STYLES WITH SHADOW ========== -->
 <!-- Base card style with shadow -->
 <Style x:Key="CardStyle" TargetType="Border">
 <Setter Property="CornerRadius" Value="12"/>
 <Setter Property="Padding" Value="20"/>
 <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
 <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
 <Setter Property="BorderThickness" Value="1"/>
 <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
 <Setter Property="Shadow" Value="{StaticResource CardShadow}"/>
 </Style>

 <!-- Interactive card style with hover effects -->
 <Style x:Key="InteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
 <Setter Property="RenderTransform">
 <Setter.Value>
 <ScaleTransform ScaleX="1" ScaleY="1"/>
 </Setter.Value>
 </Setter>
 </Style>

 <!-- ========== ENTRANCE ANIMATIONS ========== -->
 <!-- Staggered entrance for cards -->
 <Storyboard x:Key="CardEntranceAnimation" x:Name="CardEntranceAnimation">
 <DoubleAnimation
 Storyboard.TargetProperty="Opacity"
 From="0" To="1"
 Duration="0:0:0.4"
 EasingFunction="{StaticResource ExponentialEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
 From="30" To="0"
 Duration="0:0:0.5"
 EasingFunction="{StaticResource BackEase}"/>
 </Storyboard>

 <!-- Element entrance animation -->
 <Storyboard x:Key="ElementEntranceAnimation">
 <DoubleAnimation
 Storyboard.TargetProperty="Opacity"
 From="0" To="1"
 Duration="0:0:0.3"
 EasingFunction="{StaticResource QuadraticEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
 From="20" To="0"
 Duration="0:0:0.35"
 EasingFunction="{StaticResource QuadraticEase}"/>
 </Storyboard>

 <!-- Fade in animation -->
 <Storyboard x:Key="FadeInAnimation">
 <DoubleAnimation
 Storyboard.TargetProperty="Opacity"
 From="0" To="1"
 Duration="0:0:0.25"
 EasingFunction="{StaticResource QuadraticEase}"/>
 </Storyboard>

 <!-- ========== HOVER ANIMATIONS ========== -->
 <!-- Card hover scale up -->
 <Storyboard x:Key="CardHoverEnterStoryboard">
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
 To="1.02" Duration="0:0:0.15"
 EasingFunction="{StaticResource QuadraticEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
 To="1.02" Duration="0:0:0.15"
 EasingFunction="{StaticResource QuadraticEase}"/>
 </Storyboard>

 <!-- Card hover scale down (back to normal) -->
 <Storyboard x:Key="CardHoverExitStoryboard">
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
 To="1" Duration="0:0:0.15"
 EasingFunction="{StaticResource QuadraticEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
 To="1" Duration="0:0:0.15"
 EasingFunction="{StaticResource QuadraticEase}"/>
 </Storyboard>

 <!-- ========== BUTTON ANIMATIONS ========== -->
 <!-- Button press animation -->
 <Storyboard x:Key="ButtonPressStoryboard">
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
 To="0.95" Duration="0:0:0.05"
 EasingFunction="{StaticResource QuadraticEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
 To="0.95" Duration="0:0:0.05"
 EasingFunction="{StaticResource QuadraticEase}"/>
 </Storyboard>

 <!-- Button release animation -->
 <Storyboard x:Key="ButtonReleaseStoryboard">
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
 To="1" Duration="0:0:0.1"
 EasingFunction="{StaticResource BackEase}"/>
 <DoubleAnimation
 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
 To="1" Duration="0:0:0.1"
 EasingFunction="{StaticResource BackEase}"/>
 </Storyboard>

 <!-- Animated button style -->
 <Style x:Key="AnimatedButtonStyle" TargetType="Button">
 <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
 <Setter Property="RenderTransform">
 <Setter.Value>
 <ScaleTransform ScaleX="1" ScaleY="1"/>
 </Setter.Value>
 </Setter>
 </Style>

 <!-- Accent button with press effect -->
 <Style x:Key="AnimatedAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
 <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
 <Setter Property="RenderTransform">
 <Setter.Value>
 <ScaleTransform ScaleX="1" ScaleY="1"/>
 </Setter.Value>
 </Setter>
 </Style>

 <!-- ========== PAGE TRANSITIONS ========== -->
 <!-- Default page transition -->
 <TransitionCollection x:Key="PageTransitions">
 <EntranceThemeTransition FromHorizontalOffset="50"/>
 </TransitionCollection>

 <!-- ========== REVEAL EFFECT BRUSHES ========== -->
 <!-- Spotlight reveal brush for cards -->
 <LinearGradientBrush x:Key="RevealBrush" StartPoint="0,0" EndPoint="1,1">
 <GradientStop Color="#33FFFFFF" Offset="0"/>
 <GradientStop Color="#00FFFFFF" Offset="1"/>
 </LinearGradientBrush>
 </ResourceDictionary>
 </Application.Resources>
</Application>
