<?xml version="1.0" encoding="utf-8"?>
<Window
 x:Class="ZUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:ZUI"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d"
 Title="Z-UI">

 <Window.SystemBackdrop>
 <MicaBackdrop Kind="Base"/>
 </Window.SystemBackdrop>

<Grid x:Name="RootGrid">
    <!-- TitleBar -->
    <Grid x:Name="AppTitleBar"
      Height="40"
      Background="Transparent"
      VerticalAlignment="Top">
      <Grid.Resources>
        <!-- Animation storyboards for back button and page title -->
        <Storyboard x:Name="ShowBackButtonStoryboard">
          <DoubleAnimation Storyboard.TargetName="TitleBarBackButton"
                          Storyboard.TargetProperty="Opacity"
                          From="0" To="1" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="TitleBarBackButton"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                          From="-20" To="0" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
              <ExponentialEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="HideBackButtonStoryboard">
          <DoubleAnimation Storyboard.TargetName="TitleBarBackButton"
                          Storyboard.TargetProperty="Opacity"
                          From="1" To="0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="TitleBarBackButton"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                          From="0" To="-20" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="ShowPageTitleStoryboard">
          <DoubleAnimation Storyboard.TargetName="PageTitleText"
                          Storyboard.TargetProperty="Opacity"
                          From="0" To="1" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="PageTitleText"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                          From="20" To="0" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
              <ExponentialEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="HidePageTitleStoryboard">
          <DoubleAnimation Storyboard.TargetName="PageTitleText"
                          Storyboard.TargetProperty="Opacity"
                          From="1" To="0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="PageTitleText"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                          From="0" To="20" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
              <QuadraticEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </Grid.Resources>

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>  <!-- Back button -->
        <ColumnDefinition Width="Auto"/>  <!-- App icon -->
        <ColumnDefinition Width="Auto"/>  <!-- App title -->
        <ColumnDefinition Width="*"/>     <!-- Page title (scrollable) -->
      </Grid.ColumnDefinitions>

      <!-- Floating Back Button (visible on scroll) -->
      <Button x:Name="TitleBarBackButton"
        Grid.Column="0"
        Width="40" Height="40"
        Margin="8,0,0,0"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="8"
        Click="TitleBarBackButton_Click"
        Opacity="0"
        IsHitTestVisible="False"
        ToolTipService.ToolTip="Назад">
        <Button.RenderTransform>
          <TranslateTransform X="-20"/>
        </Button.RenderTransform>
        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
      </Button>

      <!-- App Icon -->
      <Image Grid.Column="1"
        Source="Assets/Z-UI-16x16.png"
        Width="16" Height="16"
        VerticalAlignment="Center"
        Margin="6,0,0,0"/>

      <!-- App Title (always visible) -->
      <TextBlock x:Name="AppTitleText"
        Grid.Column="2"
        Text="Z-UI"
        FontSize="12"
        FontWeight="SemiBold"
        VerticalAlignment="Center"
        Margin="10,0,0,0"
        Style="{StaticResource CaptionTextBlockStyle}"/>

      <!-- Page Title (shows on scroll with back button) -->
      <TextBlock x:Name="PageTitleText"
        Grid.Column="3"
        Text=""
        FontSize="12"
        FontWeight="SemiBold"
        VerticalAlignment="Center"
        Margin="8,0,0,0"
        Style="{StaticResource CaptionTextBlockStyle}"
        Opacity="0"
        IsHitTestVisible="False">
        <TextBlock.RenderTransform>
          <TranslateTransform X="20"/>
        </TextBlock.RenderTransform>
      </TextBlock>
    </Grid>

 <!-- Frame-based navigation — transitions are controlled per-navigation via NavigationService -->
 <Frame x:Name="RootFrame" Margin="0,40,0,0">
 </Frame>
</Grid>
</Window>
