<Project>
  <!-- Workaround for .NET 10 XamlCompiler exit code 1 issue (Windows App SDK 2.0) -->
  <Target Name="ForceXamlCompilerSuccess" AfterTargets="_GenerateProjectPriFileCore;XamlCompiler;MarkupCompilePass1">
    <Warning Text="XamlCompiler completed (exit code ignored for .NET 10 compatibility)" />
  </Target>
  <PropertyGroup>
    <MSBuildContinueOnError>true</MSBuildContinueOnError>
  </PropertyGroup>
</Project>
